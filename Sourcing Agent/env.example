# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# TiDB Cloud — get these from your TiDB Cloud cluster's "Connect" panel
TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=event_intelligence

# Dashboard server port
DASHBOARD_PORT=3001

# Scheduler: cron expression (default = 07:00 every day)
CRON_SCHEDULE=0 7 * * *
